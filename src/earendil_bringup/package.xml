<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>earendil_bringup</name>
  <version>1.0.0</version>
  <description>Main launch files for real Earendil vehicle deployment on RPi5</description>

  <maintainer email="dev@earendil.local">Earendil Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>earendil_interfaces</exec_depend>
  <exec_depend>earendil_safety</exec_depend>
  <exec_depend>earendil_control</exec_depend>
  <exec_depend>earendil_sensors</exec_depend>
  <exec_depend>earendil_navigation</exec_depend>
  <exec_depend>earendil_web</exec_depend>
  <exec_depend>earendil_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
