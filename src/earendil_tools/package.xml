<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>earendil_tools</name>
  <version>1.0.0</version>
  <description>Quarantine for earendil.py (PC-side PySide6 debug GUI) and helper utilities. NOT part of the vehicle runtime stack.</description>

  <maintainer email="dev@earendil.local">Earendil Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
